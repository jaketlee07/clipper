# Copy to .env and fill in. Paste values after "=" with no spaces or quotes.
# Everything is optional: missing keys switch that step off, and `npm run check` says which.

# Claude ranks the moments and writes hooks (about $0.10 per hour of VOD).
# Without it, clips are picked by signal score alone and get no hook title.
ANTHROPIC_API_KEY=

# Discord: Server Settings > Integrations > Webhooks > New Webhook, on #clips-ready.
DISCORD_WEBHOOK_URL=
# Optional second webhook for the 30-minute submit reminders (#posted). Falls back to the one above.
DISCORD_POSTED_WEBHOOK_URL=

# Twitch viewer clips signal: https://dev.twitch.tv/console/apps > Register (category: Other,
# redirect http://localhost). Free. Without these, ranking uses chat and audio only.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: path to a whisper.cpp model. Default downloads ggml-large-v3-turbo-q5_0.bin (574 MB) once.
WHISPER_MODEL=
# Optional: a Chrome/Chromium for Remotion to render with, if it can't download its own.
BROWSER_EXECUTABLE=
